{
  "name": "vscode-sonarqube-dashboard-pipeline",
  "displayName": "SonarQube Dashboard & Pipeline",
  "description": "%extension.description%",
  "version": "1.3.0",
  "publisher": "jesusromero",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "media/sonarqube-dashboard.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jesusromero92/SonarQube-Dashboard_ExtensionVS.git"
  },
  "bugs": {
    "url": "https://github.com/jesusromero92/SonarQube-Dashboard_ExtensionVS/issues"
  },
  "homepage": "https://github.com/jesusromero92/SonarQube-Dashboard_ExtensionVS#readme",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Linters",
    "Testing",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:sonarQubeDashboard.launcher",
    "onView:sonarQubeDashboard.pipelineExecutions",
    "onWebviewPanel:sonarQubeDashboard.panel",
    "onCommand:sonarQubeDashboard.open",
    "onCommand:sonarQubeDashboard.refresh",
    "onCommand:sonarQubeDashboard.clear",
    "onCommand:sonarQubeDashboard.analyze",
    "onCommand:sonarQubeDashboard.cancelAnalysis",
    "onCommand:sonarQubeDashboard.nextIssue",
    "onCommand:sonarQubeDashboard.previousIssue",
    "onCommand:sonarQubeDashboard.nextIssueSameType",
    "onCommand:sonarQubeDashboard.nextCriticalIssue",
    "onCommand:sonarQubeDashboard.toggleCurrentFileIssues",
    "onCommand:sonarQubeDashboard.groupIssues",
    "onCommand:sonarQubeDashboard.copyFileIssues",
    "onCommand:sonarQubeDashboard.showCoverage",
    "onCommand:sonarQubeDashboard.previousFlowLocation",
    "onCommand:sonarQubeDashboard.nextFlowLocation",
    "onCommand:sonarQubeDashboard.getStarted",
    "onCommand:sonarQubeDashboard.configure"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sonarQubeDashboardContainer",
          "title": "%views.container.title%",
          "icon": "media/SonarQube.svg"
        }
      ]
    },
    "views": {
      "sonarQubeDashboardContainer": [
        {
          "type": "webview",
          "id": "sonarQubeDashboard.launcher",
          "name": "%views.panel.name%",
          "visibility": "visible",
          "contextualTitle": "%views.container.title%"
        },
        {
          "id": "sonarQubeDashboard.pipelineExecutions",
          "name": "%views.pipelineExecutions.name%",
          "when": "workspaceFolderCount > 0"
        },
        {
          "id": "sonarQubeDashboard.issueTree",
          "name": "%views.issues.name%",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "commands": [
      {
        "command": "sonarQubeDashboard.getStarted",
        "title": "%command.getStarted%",
        "icon": "$(rocket)"
      },
      {
        "command": "sonarQubeDashboard.configure",
        "title": "%command.configure%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "sonarQubeDashboard.open",
        "title": "%command.open%",
        "icon": "$(dashboard)"
      },
      {
        "command": "sonarQubeDashboard.refresh",
        "title": "%command.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "sonarQubeDashboard.clear",
        "title": "%command.clear%",
        "icon": "$(clear-all)"
      },
      {
        "command": "sonarQubeDashboard.analyze",
        "title": "%command.analyze%",
        "icon": "$(play)"
      },
      {
        "command": "sonarQubeDashboard.cancelAnalysis",
        "title": "%command.cancelAnalysis%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "sonarQubeDashboard.nextIssue",
        "title": "%command.nextIssue%",
        "icon": "$(arrow-down)"
      },
      {
        "command": "sonarQubeDashboard.previousIssue",
        "title": "%command.previousIssue%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "sonarQubeDashboard.nextIssueSameType",
        "title": "%command.nextIssueSameType%",
        "icon": "$(symbol-event)"
      },
      {
        "command": "sonarQubeDashboard.nextCriticalIssue",
        "title": "%command.nextCriticalIssue%",
        "icon": "$(error)"
      },
      {
        "command": "sonarQubeDashboard.toggleCurrentFileIssues",
        "title": "%command.toggleCurrentFileIssues%",
        "icon": "$(filter)"
      },
      {
        "command": "sonarQubeDashboard.groupIssues",
        "title": "%command.groupIssues%",
        "icon": "$(group-by-ref-type)"
      },
      {
        "command": "sonarQubeDashboard.copyFileIssues",
        "title": "%command.copyFileIssues%",
        "icon": "$(copy)"
      },
      {
        "command": "sonarQubeDashboard.previousFlowLocation",
        "title": "%command.previousFlowLocation%",
        "icon": "$(arrow-left)"
      },
      {
        "command": "sonarQubeDashboard.nextFlowLocation",
        "title": "%command.nextFlowLocation%",
        "icon": "$(arrow-right)"
      },
      {
        "command": "sonarQubeDashboard.showCoverage",
        "title": "%command.showCoverage%",
        "icon": "$(graph)"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "sonarQubeDashboard.language": {
          "type": "string",
          "default": "en",
          "scope": "window",
          "enum": [
            "en",
            "es"
          ],
          "enumDescriptions": [
            "%configuration.language.en%",
            "%configuration.language.es%"
          ],
          "description": "%configuration.language.description%"
        },
        "sonarQubeDashboard.sonar.serverUrl": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%configuration.sonar_serverUrl.description%"
        },
        "sonarQubeDashboard.sonar.projectKey": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%configuration.sonar_projectKey.description%"
        },
        "sonarQubeDashboard.sonar.projectName": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%configuration.sonar_projectName.description%"
        },
        "sonarQubeDashboard.sonar.branch": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%configuration.sonar_branch.description%"
        },
        "sonarQubeDashboard.sonar.baseDir": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%configuration.sonar_baseDir.description%"
        },
        "sonarQubeDashboard.autoRefresh": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "%configuration.autoRefresh.description%"
        },
        "sonarQubeDashboard.refreshIntervalMinutes": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "scope": "window",
          "description": "%configuration.refreshIntervalMinutes.description%"
        },
        "sonarQubeDashboard.sonar.scannerMode": {
          "type": "string",
          "default": "auto",
          "scope": "resource",
          "enum": [
            "auto",
            "maven",
            "gradle",
            "dotnet",
            "npm",
            "docker",
            "custom"
          ],
          "enumDescriptions": [
            "%configuration.scannerMode.auto%",
            "%configuration.scannerMode.maven%",
            "%configuration.scannerMode.gradle%",
            "%configuration.scannerMode.dotnet%",
            "%configuration.scannerMode.npm%",
            "%configuration.scannerMode.docker%",
            "%configuration.scannerMode.custom%"
          ],
          "description": "%configuration.sonar_scannerMode.description%"
        },
        "sonarQubeDashboard.sonar.analysisInclusions": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%configuration.sonar_analysisInclusions.description%"
        },
        "sonarQubeDashboard.sonar.analysisExclusions": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%configuration.sonar_analysisExclusions.description%"
        },
        "sonarQubeDashboard.sonar.buildCommand": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%configuration.sonar_buildCommand.description%"
        },
        "sonarQubeDashboard.sonar.customScannerCommand": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%configuration.sonar_customScannerCommand.description%"
        },
        "sonarQubeDashboard.sonar.preAnalysisCommands": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%configuration.sonar_preAnalysisCommands.description%"
        },
        "sonarQubeDashboard.sonar.postAnalysisCommands": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%configuration.sonar_postAnalysisCommands.description%"
        },
        "sonarQubeDashboard.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "%configuration.notifications.enabled%"
        },
        "sonarQubeDashboard.notifications.significantIncreasePercent": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 1000,
          "scope": "window",
          "description": "%configuration.notifications.significantIncreasePercent%"
        },
        "sonarQubeDashboard.notifications.significantIncreaseMinimum": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "scope": "window",
          "description": "%configuration.notifications.significantIncreaseMinimum%"
        }
      }
    },
    "keybindings": [
      {
        "command": "sonarQubeDashboard.nextIssue",
        "key": "ctrl+alt+down",
        "mac": "cmd+alt+down",
        "when": "editorTextFocus"
      },
      {
        "command": "sonarQubeDashboard.previousIssue",
        "key": "ctrl+alt+up",
        "mac": "cmd+alt+up",
        "when": "editorTextFocus"
      },
      {
        "command": "sonarQubeDashboard.nextIssueSameType",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "editorTextFocus"
      },
      {
        "command": "sonarQubeDashboard.nextCriticalIssue",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sonarQubeDashboard.groupIssues",
          "when": "view == sonarQubeDashboard.issueTree",
          "group": "navigation@1"
        },
        {
          "command": "sonarQubeDashboard.toggleCurrentFileIssues",
          "when": "view == sonarQubeDashboard.issueTree",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "sonarQubeDashboard.copyFileIssues",
          "when": "view == sonarQubeDashboard.issueTree && viewItem == sonarIssueFileGroup",
          "group": "1_copy@1"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "sonarQubeDashboard.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "openDashboard",
            "title": "%walkthrough.open.title%",
            "description": "%walkthrough.open.description%",
            "media": {
              "image": "docs/images/sidebar-summary.png",
              "altText": "%walkthrough.open.alt%"
            },
            "completionEvents": [
              "onCommand:sonarQubeDashboard.open"
            ]
          },
          {
            "id": "connectProject",
            "title": "%walkthrough.connect.title%",
            "description": "%walkthrough.connect.description%",
            "media": {
              "image": "docs/images/configuration.png",
              "altText": "%walkthrough.connect.alt%"
            },
            "completionEvents": [
              "onCommand:sonarQubeDashboard.configure"
            ]
          },
          {
            "id": "runAnalysis",
            "title": "%walkthrough.analyze.title%",
            "description": "%walkthrough.analyze.description%",
            "media": {
              "image": "docs/images/analysis-pipeline-execution.png",
              "altText": "%walkthrough.analyze.alt%"
            },
            "completionEvents": [
              "onCommand:sonarQubeDashboard.analyze"
            ]
          },
          {
            "id": "inspectResults",
            "title": "%walkthrough.results.title%",
            "description": "%walkthrough.results.description%",
            "media": {
              "image": "docs/images/dashboard-overview.png",
              "altText": "%walkthrough.results.alt%"
            }
          }
        ]
      }
    ],
    "viewsWelcome": [
      {
        "view": "sonarQubeDashboard.issueTree",
        "contents": "%viewsWelcome.issues%"
      },
      {
        "view": "sonarQubeDashboard.pipelineExecutions",
        "contents": "%viewsWelcome.pipeline%"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "test": "npm run compile && tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "watch": "tsc -watch -p ./",
    "package": "npx --yes @vscode/vsce package",
    "package:vsix": "powershell -ExecutionPolicy Bypass -File ./generar-vsix.ps1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.96.0",
    "typescript": "^5.7.2"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrusted.description%",
      "restrictedConfigurations": [
        "sonarQubeDashboard.sonar.buildCommand",
        "sonarQubeDashboard.sonar.customScannerCommand",
        "sonarQubeDashboard.sonar.preAnalysisCommands",
        "sonarQubeDashboard.sonar.postAnalysisCommands"
      ]
    }
  },
  "keywords": [
    "sonarqube",
    "sonar",
    "quality gate",
    "code quality",
    "static analysis",
    "sast",
    "devsecops",
    "security",
    "security hotspots",
    "vulnerabilities",
    "code smells",
    "technical debt",
    "coverage",
    "code coverage",
    "duplication",
    "pipeline",
    "ci",
    "quality pipeline",
    "npm audit",
    "semgrep",
    "trivy",
    "maven",
    "gradle",
    "dotnet",
    "typescript"
  ],
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "pricing": "Free",
  "markdown": "github",
  "qna": "https://github.com/jesusromero92/SonarQube-Dashboard_ExtensionVS/issues",
  "extensionKind": [
    "workspace"
  ]
}
