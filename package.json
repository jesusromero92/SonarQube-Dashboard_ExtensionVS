{
  "name": "vscode-sonarqube-dashboard",
  "displayName": "SonarQube Dashboard",
  "description": "Dashboard de SonarQube para VS Code con análisis del repositorio, Problems, Quality Gate, defectos, hotspots, rankings y evolución.",
  "version": "0.14.0",
  "publisher": "jesusromero",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "media/sonarqube-dashboard.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesusromero92/SonarQube-Dashboard_ExtensionVS.git"
  },
  "bugs": {
    "url": "https://github.com/jesusromero92/SonarQube-Dashboard_ExtensionVS/issues"
  },
  "homepage": "https://github.com/jesusromero92/SonarQube-Dashboard_ExtensionVS#readme",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:sonarQubeDashboard.launcher",
    "onWebviewPanel:sonarQubeDashboard.panel",
    "onCommand:sonarQubeDashboard.open",
    "onCommand:sonarQubeDashboard.refresh",
    "onCommand:sonarQubeDashboard.clear",
    "onCommand:sonarQubeDashboard.analyze",
    "onCommand:sonarQubeDashboard.cancelAnalysis"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sonarQubeDashboardContainer",
          "title": "SonarQube Dashboard",
          "icon": "media/sonarqube-dashboard.svg"
        }
      ]
    },
    "views": {
      "sonarQubeDashboardContainer": [
        {
          "type": "webview",
          "id": "sonarQubeDashboard.launcher",
          "name": "Panel",
          "visibility": "visible",
          "contextualTitle": "SonarQube Dashboard"
        }
      ]
    },
    "commands": [
      {
        "command": "sonarQubeDashboard.open",
        "title": "SonarQube Dashboard: Abrir dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "sonarQubeDashboard.refresh",
        "title": "SonarQube Dashboard: Actualizar issues",
        "icon": "$(refresh)"
      },
      {
        "command": "sonarQubeDashboard.clear",
        "title": "SonarQube Dashboard: Limpiar Problems",
        "icon": "$(clear-all)"
      },
      {
        "command": "sonarQubeDashboard.analyze",
        "title": "SonarQube Dashboard: Analizar repositorio",
        "icon": "$(play)"
      },
      {
        "command": "sonarQubeDashboard.cancelAnalysis",
        "title": "SonarQube Dashboard: Cancelar análisis",
        "icon": "$(debug-stop)"
      }
    ],
    "configuration": {
      "title": "SonarQube Dashboard",
      "properties": {
        "sonarQubeDashboard.sonar.serverUrl": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "URL de SonarQube. Se gestiona desde SonarQube Dashboard."
        },
        "sonarQubeDashboard.sonar.projectKey": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Proyecto de SonarQube. Se gestiona desde SonarQube Dashboard."
        },
        "sonarQubeDashboard.sonar.branch": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Rama de SonarQube. Se gestiona desde SonarQube Dashboard."
        },
        "sonarQubeDashboard.sonar.baseDir": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Subcarpeta local asociada a la raíz del proyecto. Se gestiona desde el dashboard."
        },
        "sonarQubeDashboard.autoRefresh": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Actualiza los issues automáticamente al abrir o cambiar el workspace."
        },
        "sonarQubeDashboard.refreshIntervalMinutes": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "scope": "window",
          "description": "Intervalo de actualización. 0 desactiva la actualización periódica."
        },
        "sonarQubeDashboard.sonar.scannerMode": {
          "type": "string",
          "default": "auto",
          "scope": "resource",
          "enum": [
            "auto",
            "maven",
            "gradle",
            "dotnet",
            "npm",
            "docker",
            "custom"
          ],
          "enumDescriptions": [
            "Detecta Maven, Gradle y .NET; usa NPM con package.json o Docker para proyectos genéricos.",
            "Usa SonarScanner for Maven.",
            "Usa SonarScanner for Gradle.",
            "Usa SonarScanner for .NET.",
            "Usa SonarScanner for NPM como scanner genérico.",
            "Usa la imagen sonarsource/sonar-scanner-cli.",
            "Ejecuta el comando personalizado configurado."
          ],
          "description": "Método empleado por el botón Analizar repositorio."
        },
        "sonarQubeDashboard.sonar.buildCommand": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Comando de compilación opcional ejecutado antes del scanner genérico o en lugar de dotnet build."
        },
        "sonarQubeDashboard.sonar.customScannerCommand": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Comando personalizado de análisis. El token se proporciona mediante SONAR_TOKEN."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx --yes @vscode/vsce package",
    "package:vsix": "powershell -ExecutionPolicy Bypass -File ./generar-vsix.ps1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.96.0",
    "typescript": "^5.7.2"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "El dashboard puede consultar SonarQube, pero analizar el repositorio requiere confiar en el workspace.",
      "restrictedConfigurations": [
        "sonarQubeDashboard.sonar.buildCommand",
        "sonarQubeDashboard.sonar.customScannerCommand"
      ]
    }
  }
}
